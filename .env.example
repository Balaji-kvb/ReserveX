# ReserveX Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=reservex
POSTGRES_USER=reservex
POSTGRES_PASSWORD=changeme

# Service URLs (for local development)
USER_SERVICE_URL=http://localhost:5001
EVENT_SERVICE_URL=http://localhost:5002
BOOKING_SERVICE_URL=http://localhost:5003

# AWS (Tier 2/3)
AWS_REGION=ap-south-1
# AWS_ACCOUNT_ID=

# Lambda (Tier 3)
# LAMBDA_FUNCTION_NAME=reservex-notification
# LAMBDA_ENABLED=false
