# Secret: sensitive data stored encoded (base64).
# WHY: Keeps passwords out of ConfigMaps, Dockerfiles, and Git.
# Kubernetes mounts them as env vars or files in the pod.
#
# NOTE: In production, use AWS Secrets Manager or Vault.
# Kubernetes Secrets are base64-encoded, NOT encrypted at rest by default.
# For this academic project, this is acceptable.
#
# Values are base64 encoded. To encode: echo -n "value" | base64
apiVersion: v1
kind: Secret
metadata:
  name: reservex-db-secret
  namespace: reservex
type: Opaque
data:
  # Base64-encode the real values only when creating the actual local secret.
  # NEVER commit the real secret to Git.
  #
  # Example:
  # echo -n "postgresql://reservex:YOUR_PASSWORD@postgres:5432/reservex" | base64

  DATABASE_URL: cG9zdGdyZXNxbDovL3Jlc2VydmV4OlJFUExBQ0VfTUVfUEFTU1dPUkRAcG9zdGdyZXM6NTQzMi9yZXNlcnZleA==
  POSTGRES_USER: cmVzZXJ2ZXg=
  POSTGRES_PASSWORD: UkVQTEFDRV9NRV9QQVNTV09SRA==
  POSTGRES_DB: cmVzZXJ2ZXg=
